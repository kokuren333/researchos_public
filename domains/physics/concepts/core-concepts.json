{"schema_version":"1.0","domain":"physics","core_concepts":[
{"id":"physical-quantity","title":{"ja":"物理量","en":"Physical Quantity"},"definition":"現象を比較・測定するための量。","prerequisites":[]},
{"id":"unit","title":{"ja":"単位","en":"Unit"},"definition":"物理量を数値で表すための基準。","prerequisites":["physical-quantity"]},
{"id":"measurement","title":{"ja":"測定","en":"Measurement"},"definition":"対象の量を観測可能な手続きで結びつけること。","prerequisites":["physical-quantity","unit"]},
{"id":"state","title":{"ja":"状態","en":"State"},"definition":"ある時点の系を記述する情報。","prerequisites":["physical-quantity"]},
{"id":"system","title":{"ja":"系","en":"System"},"definition":"分析の対象として切り出した世界の一部分。","prerequisites":["state"]},
{"id":"model","title":{"ja":"モデル","en":"Model"},"definition":"現象の重要な構造を選んで表す記述。","prerequisites":["system"]},
{"id":"idealization","title":{"ja":"理想化","en":"Idealization"},"definition":"複雑な現実から目的に必要な構造を抽出すること。","prerequisites":["model"]},
{"id":"approximation","title":{"ja":"近似","en":"Approximation"},"definition":"適用範囲を明示して計算可能な形に単純化すること。","prerequisites":["idealization"]},
{"id":"scale","title":{"ja":"スケール","en":"Scale"},"definition":"長さ・時間・エネルギーなどの観測の尺度。","prerequisites":["physical-quantity"]},
{"id":"dynamics","title":{"ja":"力学・ダイナミクス","en":"Dynamics"},"definition":"状態が時間とともに変化する規則。","prerequisites":["state","model"]},
{"id":"interaction","title":{"ja":"相互作用","en":"Interaction"},"definition":"系の構成要素が互いの状態変化に影響する仕組み。","prerequisites":["system","dynamics"]},
{"id":"force","title":{"ja":"力","en":"Force"},"definition":"運動状態の変化を記述する相互作用の表現。","prerequisites":["interaction"]},
{"id":"energy","title":{"ja":"エネルギー","en":"Energy"},"definition":"状態変化を横断して記述する保存量。","prerequisites":["state","dynamics"]},
{"id":"momentum","title":{"ja":"運動量","en":"Momentum"},"definition":"運動と並進対称性に結びつく保存量。","prerequisites":["dynamics"]},
{"id":"conservation-law","title":{"ja":"保存則","en":"Conservation Law"},"definition":"変化の前後で特定の量が保たれるという制約。","prerequisites":["energy","momentum"]},
{"id":"symmetry","title":{"ja":"対称性","en":"Symmetry"},"definition":"変換しても物理法則の構造が変わらない性質。","prerequisites":["model"]},
{"id":"equilibrium","title":{"ja":"平衡","en":"Equilibrium"},"definition":"巨視的な変化が釣り合った状態。","prerequisites":["state","dynamics"]},
{"id":"field","title":{"ja":"場","en":"Field"},"definition":"空間と時間の各点に量を割り当てる記述。","prerequisites":["physical-quantity","system"]},
{"id":"potential","title":{"ja":"ポテンシャル","en":"Potential"},"definition":"力や状態変化を生成する空間依存の関数。","prerequisites":["field","energy"]},
{"id":"oscillation","title":{"ja":"振動","en":"Oscillation"},"definition":"平衡の周りを周期的に変化する運動。","prerequisites":["equilibrium","dynamics"]},
{"id":"wave","title":{"ja":"波","en":"Wave"},"definition":"変動のパターンが空間を伝播する現象。","prerequisites":["oscillation","field"]},
{"id":"continuum","title":{"ja":"連続体","en":"Continuum"},"definition":"物質や空間を連続な場として近似するモデル。","prerequisites":["field","approximation"]},
{"id":"entropy","title":{"ja":"エントロピー","en":"Entropy"},"definition":"状態の分布や不可逆性を測る量。","prerequisites":["state","energy"]},
{"id":"temperature","title":{"ja":"温度","en":"Temperature"},"definition":"熱平衡とエネルギー分布を特徴づける量。","prerequisites":["equilibrium","energy"]},
{"id":"probability","title":{"ja":"確率","en":"Probability"},"definition":"不確定な状態や多数系を記述する数学。","prerequisites":["state"]},
{"id":"spacetime","title":{"ja":"時空","en":"Spacetime"},"definition":"空間と時間を統一して扱う構造。","prerequisites":["measurement","symmetry"]},
{"id":"relativity","title":{"ja":"相対性","en":"Relativity"},"definition":"観測者によらない法則の構造を探る理論。","prerequisites":["spacetime","symmetry"]},
{"id":"quantum-state","title":{"ja":"量子状態","en":"Quantum State"},"definition":"量子系の予測可能な状態を表す記述。","prerequisites":["state","probability"]},
{"id":"superposition","title":{"ja":"重ね合わせ","en":"Superposition"},"definition":"複数の可能な状態を一つの量子状態として表す原理。","prerequisites":["quantum-state"]},
{"id":"effective-theory","title":{"ja":"有効理論","en":"Effective Theory"},"definition":"特定のスケールと精度で有効なモデル。","prerequisites":["scale","approximation","model"]}
]}
