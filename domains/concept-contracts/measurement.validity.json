{"concept":"measurement.validity","learning_contract":{"essential_question":["測定値からconstructについてどこまで主張できるか"],"must_understand":["validity concerns interpretation","construct, operationalization, measurement are distinct","reliability is not sufficient","validity depends on context","validity uses converging evidence"],"must_distinguish":["measurement.reliability","measurement.accuracy","measurement.proxy"],"must_apply":["clinical scale","physical measurement","proxy measurement outside medicine"]},"required_claims":[{"id":"interpretation-centered","claim":"Validityは測定結果から行う解釈・推論の支持に関する。"},{"id":"construct-separation","claim":"Construct、operationalization、measurementは区別される。"},{"id":"reliability-not-sufficient","claim":"高いreliabilityだけでは高いvalidityを保証しない。"},{"id":"context-dependent","claim":"Validityはpopulation、context、purposeに依存する。"},{"id":"converging-evidence","claim":"Validityは複数の証拠を総合して評価される。"},{"id":"downstream-constraint","claim":"妥当性問題は下流の統計・因果推論を制約する。"}],"claim_evidence":[{"claim_id":"interpretation-centered","source":"https://www.ncbi.nlm.nih.gov/books/NBK305233","locator":"Validity section"},{"claim_id":"reliability-not-sufficient","source":"https://www.ncbi.nlm.nih.gov/books/NBK557471","locator":"Reliability section"}],"examples":{"canonical":{"topic":"PHQ-9","purpose":"constructと操作化を区別する"},"counterexample":{"topic":"+5kgずれる体重計","purpose":"reliabilityとvalidityを区別する"},"boundary":{"topic":"別集団への尺度移送","purpose":"context dependenceを示す"},"transfer":{"topic":"GitHub starsをOSS品質のproxyにする","purpose":"他分野へ転用する"}},"quality_gate":{"learner_can_explain":["reliableでもinvalidになりうる理由"],"learner_can_distinguish":["construct","operationalization","measurement","validity","reliability"],"learner_can_transfer":["医学以外のproxy measurementへ適用する"],"learner_can_limit_claim":["evidence不足時にunknownまたはpartialとする"]}}
